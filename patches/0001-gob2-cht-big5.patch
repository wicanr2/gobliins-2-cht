+// getenv 在 ScummVM 是禁用符號，要單獨開例外
+#define FORBIDDEN_SYMBOL_EXCEPTION_getenv
+#define FORBIDDEN_SYMBOL_EXCEPTION_fopen
+#define FORBIDDEN_SYMBOL_EXCEPTION_fwrite
+#define FORBIDDEN_SYMBOL_EXCEPTION_fclose
+#define FORBIDDEN_SYMBOL_EXCEPTION_sprintf
+#define FORBIDDEN_SYMBOL_EXCEPTION_FILE
+
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "common/file.h"
+#include "common/debug.h"
+#include "graphics/big5.h"
+
+#include "gob/cht.h"
+#include "gob/gob.h"
+#include "gob/surface.h"
+
+namespace Gob {
+
+Cht::Cht() : _enabled(false), _logText(false), _dumpSpr(nullptr), _font(nullptr) {
+	const char *env = getenv("GOB_LOG_TEXT");
+	_logText = env && *env && *env != '0';
+
+	_dumpSpr = getenv("GOB_DUMP_SPR");
+	if (_dumpSpr && !*_dumpSpr)
+		_dumpSpr = nullptr;
+}
+
+uint32 Cht::signature(const byte *sprBuf, int16 w, int16 h) {
+	// 內容簽章：尺寸 + 前 256 byte 的滾動 checksum。
+	// 用內容而不是資源 id —— id 會隨關卡變動，同一張圖的位元組不會。
+	uint32 sum = ((uint32)(uint16)w << 16) ^ (uint32)(uint16)h;
+	for (int i = 0; i < 256; i++)
+		sum = sum * 31 + sprBuf[i];
+	return sum;
+}
+
+void Cht::dumpSprite(const Surface &dest, const byte *sprBuf, int16 w, int16 h,
+                     int16 x, int16 y) const {
+	if (!_dumpSpr || w <= 0 || h <= 0)
+		return;
+	if (x < 0 || y < 0 || x + w > dest.getWidth() || y + h > dest.getHeight())
+		return;
+
+	char path[512];
+	sprintf(path, "%s/spr_%08x_%dx%d.raw", _dumpSpr, signature(sprBuf, w, h), w, h);
+	FILE *f = fopen(path, "wb");
+	if (!f)
+		return;
+	for (int16 row = 0; row < h; row++)
+		fwrite(dest.getData(x, y + row), 1, (size_t)w * dest.getBPP(), f);
+	fclose(f);
+}
+
+bool Cht::replaceSprite(Surface &dest, const byte *sprBuf, int16 w, int16 h,
+                        int16 x, int16 y) const {
+	if (!_enabled || _cels.empty() || w <= 0 || h <= 0)
+		return false;
+
+	const uint32 sig = signature(sprBuf, w, h);
+	Common::HashMap<uint32, Common::Array<byte> >::const_iterator it = _cels.find(sig);
+	if (it == _cels.end())
+		return false;
+
+	const Common::Array<byte> &px = it->_value;
+	if ((int)px.size() != w * h)
+		return false;
+	if (x < 0 || y < 0 || x + w > dest.getWidth() || y + h > dest.getHeight())
+		return false;
+
+	// 0xFF = 保持原樣（讓沒改到的部分透出原圖）
+	for (int16 row = 0; row < h; row++) {
+		byte *d = dest.getData(x, y + row);
+		for (int16 col = 0; col < w; col++) {
+			const byte v = px[(size_t)row * w + col];
+			if (v != 0xFF)
+				d[col * dest.getBPP()] = v;
+		}
+	}
+	return true;
+}
+
+Cht::~Cht() {
+	delete _font;
+}
+
+int Cht::charHeight() const {
+	return _font ? _font->getFontHeight() : 0;
+}
+
+Common::String Cht::normKey(const char *text) {
+	Common::String out;
+	bool pendingSpace = false;
+	bool seenNonSpace = false;
+
+	for (const char *p = text; *p; p++) {
+		byte c = (byte)*p;
+		// \r \n \t 一律當空白 —— 遊戲腳本裡的字串會夾雜這些
+		if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
+			if (seenNonSpace)
+				pendingSpace = true;
+			continue;
+		}
+		if (pendingSpace) {
+			out += ' ';
+			pendingSpace = false;
+		}
+		out += (char)c;
+		seenNonSpace = true;
+	}
+
+	return out;
+}
+
+void Cht::init(const Common::String &fontFile, const Common::String &tsvFile) {
+	Common::File f;
+
+	if (!f.open(Common::Path(fontFile))) {
+		debugC(1, kDebugFileIO, "CHT: 找不到字型 %s，維持原文", fontFile.c_str());
+		return;
+	}
+
+	_font = new Graphics::Big5Font();
+	// [HARD] 高度要跟字型檔實際的每字步幅一致。倚天 16×15 的字模每字只有 15 列，
+	// 傳 16 會讓第 N 個字偏 2N bytes ——「有些字對、有些變別的字、越後面越亂」，
+	// 而且字型涵蓋率檢查照樣回報 100%。烘字型時用 --lo-pad-height 16 補到 16 列。
+	_font->loadPrefixedRaw(f, 16);
+	f.close();
+	_enabled = true;
+
+	Common::File t;
+	if (!t.open(Common::Path(tsvFile))) {
+		warning("CHT: 有字型但找不到譯文表 %s，只會畫得出中文、不會翻譯", tsvFile.c_str());
+		return;
+	}
+
+	int n = 0;
+	while (!t.eos()) {
+		Common::String line = t.readLine();
+		if (line.empty() || line[0] == '#')
+			continue;
+
+		const char *tab = strchr(line.c_str(), '\t');
+		if (!tab)
+			continue;
+
+		Common::String key(line.c_str(), tab - line.c_str());
+		Common::String val(tab + 1);
+		if (val.empty())
+			continue;
+
+		_map[normKey(key.c_str())] = val;
+		n++;
+	}
+	t.close();
+
+	debug(1, "CHT: 字型 %s 已載入(高 %d)，譯文 %d 則", fontFile.c_str(), charHeight(), n);
+
+	// 烘進美術的中文點陣（可選）。格式："CHTS" u16 版本 u16 筆數，
+	// 每筆 u32 簽章 + u16 寬 + u16 高 + 寬*高 個索引（0xFF = 保持原樣）。
+	Common::File c;
+	if (c.open(Common::Path("gob1_cels.dat"))) {
+		char magic[5] = {0};
+		c.read(magic, 4);
+		if (!strcmp(magic, "CHTS")) {
+			c.readUint16LE();                       // 版本
+			const uint16 count = c.readUint16LE();
+			for (uint16 i = 0; i < count; i++) {
+				const uint32 sig = c.readUint32LE();
+				const uint16 w = c.readUint16LE();
+				const uint16 h = c.readUint16LE();
+				Common::Array<byte> px;
+				px.resize((uint32)w * h);
+				c.read(px.begin(), (uint32)w * h);
+				_cels[sig] = px;
+			}
+			debug(1, "CHT: 美術置換 %d 筆", count);
+		}
+		c.close();
+	}
+}
+
+const char *Cht::translate(const char *text) const {
+	if (!_enabled || !text || !*text)
+		return nullptr;
+
+	Common::HashMap<Common::String, Common::String>::const_iterator it =
+		_map.find(normKey(text));
+	if (it == _map.end())
+		return nullptr;
+
+	return it->_value.c_str();
+}
+
+bool Cht::drawChar(Surface &dest, uint16 big5, int16 x, int16 y, byte color) const {
+	if (!_font)
+		return false;
+
+	const int16 w = dest.getWidth();
+	const int16 h = dest.getHeight();
+	if (x < 0 || y < 0 || x >= w || y >= h)
+		return false;
+
+	// Big5Font 的 maxX/maxY 是「從落點算起還剩多少空間」，不是絕對座標。
+	return _font->drawBig5Char(dest.getData(x, y), big5,
+	                           w - x, h - y,
+	                           (uint32)w * dest.getBPP(),
+	                           color, 0, false, dest.getBPP());
+}
+
+void Cht::logDrawn(const char *text, bool hit) const {
+	if (!_logText || !text || !*text)
+		return;
+
+	// 用 \t 分欄，直接餵得進 skeleton 產生器
+	debug("[GOBTEXT]\t%s\t%s", hit ? "HIT" : "MISS", text);
+}
+
+int Cht::stringWidth(const char *text, int asciiWidth) const {
+	int width = 0;
+
+	for (const byte *p = (const byte *)text; *p; ) {
+		if (isBig5Lead(p[0]) && isBig5Trail(p[1])) {
+			width += kCharWidth;
+			p += 2;
+		} else {
+			width += asciiWidth;
+			p += 1;
+		}
+	}
+
+	return width;
+}
+
+} // End of namespace Gob
