+
+/*
+ * 繁體中文化支援(Gobliiins 1)。
+ *
+ * 為什麼是這個做法:
+ *   GOB 的 Font 是「單位元組定寬點陣字」(video.h 的 Font,取字介面全是 uint8 c,
+ *   _startItem/_endItem 也是 uint8),結構上裝不下 Big5,而整個 engines/gob 沒有
+ *   任何 CJK 路徑可以接。所以走旁路:Big5 字元交給 Graphics::Big5Font 畫,
+ *   單位元組字元仍走原本的 Font,兩者在繪字迴圈裡分流。
+ *
+ *   不去改 Font 的介面,是因為 GOB 引擎養了十幾款遊戲(Gobliiins 2/3、Woodruff、
+ *   Playtoons…),動 uint8 c 會全部牽動。
+ *
+ * 中文的啟用條件是「字型檔存在」,不是 ScummVM 的 --language。
+ *   理由同 AGI 軌:gob1 的偵測表本身就分五種語言(EN/DE/FR/IT/ES),而語言是
+ *   遊戲資料的維度,拿它兼作中文開關會互相打架。
+ */
+
+#ifndef GOB_CHT_H
+#define GOB_CHT_H
+
+#include "common/str.h"
+#include "common/hashmap.h"
+#include "common/hash-str.h"
+#include "common/array.h"
+
+namespace Graphics {
+class Big5Font;
+}
+
+namespace Gob {
+
+class Surface;
+
+class Cht {
+public:
+	Cht();
+	~Cht();
+
+	/** 載入字型與譯文表。字型載入成功才算啟用。 */
+	void init(const Common::String &fontFile, const Common::String &tsvFile);
+
+	bool enabled() const { return _enabled; }
+
+	/**
+	 * 內容為 key 查表。查到回中文,查不到回 nullptr(呼叫端露原文)。
+	 * 回傳的指標指向表內的字串,生命期與本物件相同 —— 這點很重要:
+	 * Draw::_textToPrint 會直接持有指標,不能給它區域變數。
+	 */
+	const char *translate(const char *text) const;
+
+	/** 是否為 Big5 前導位元組。 */
+	static bool isBig5Lead(byte c) { return c >= 0xA1 && c <= 0xF9; }
+	/** 是否為 Big5 後續位元組。 */
+	static bool isBig5Trail(byte c) {
+		return (c >= 0x40 && c <= 0x7E) || (c >= 0xA1 && c <= 0xFE);
+	}
+
+	/** 中文字的顯示寬度(像素)。 */
+	int charWidth() const { return kCharWidth; }
+	int charHeight() const;
+
+	/**
+	 * 在 gob 的 Surface 上畫一個 Big5 字。回傳是否畫出來(字型缺字就回 false)。
+	 */
+	bool drawChar(Surface &dest, uint16 big5, int16 x, int16 y, byte color) const;
+
+	/** 一個字串在中文模式下的顯示寬度,單位元組字元用 asciiWidth 計。 */
+	int stringWidth(const char *text, int asciiWidth) const;
+
+	/**
+	 * GOB_LOG_TEXT=1 時，把引擎「實際要畫出去」的每個字串印出來。
+	 *
+	 * 為什麼需要這個:靜態從 .TOT 抽到的字串，與執行期真正送進繪字迴圈的字串
+	 * 不一定相同(腳本會拼接、會補空白、會被控制碼切段)。而查表是以執行期那一份
+	 * 為準 —— SQ1 VGA 漏掉 67 則核心文字就是這種落差，三支檢查工具全測不到，
+	 * 最後是實機截圖比對才抓到的。
+	 * 這支 log 同時是抽字的來源與「翻譯有沒有命中」的驗證。
+	 */
+	bool logText() const { return _logText; }
+	void logDrawn(const char *text, bool hit) const;
+
+	/**
+	 * 烘進美術裡的英文（按鈕、招牌）中文化。
+	 *
+	 * 做法沿用 SQ1 的教訓：**不要重編整支資源檔**投進遊戲目錄 —— 重編出來的檔
+	 * 會把沒改到的原版美術一起複製一份，等於在 patch 包裡散布遊戲資源。
+	 * 改成執行期置換：畫完之後把我們自己畫的點陣蓋上去，交付檔案裡只有自畫像素。
+	 *
+	 * 定位用「內容簽章」(寬,高,前 256 byte 的 checksum) 而不是資源 id ——
+	 * id 會隨關卡變動，內容不會。
+	 */
+	bool replaceSprite(Surface &dest, const byte *sprBuf, int16 w, int16 h,
+	                   int16 x, int16 y) const;
+
+	/** GOB_DUMP_SPR=<dir> 時，把畫出去的每一張 sprite 存成索引點陣。 */
+	const char *dumpSpriteDir() const { return _dumpSpr; }
+	void dumpSprite(const Surface &dest, const byte *sprBuf, int16 w, int16 h,
+	                int16 x, int16 y) const;
+
+	static uint32 signature(const byte *sprBuf, int16 w, int16 h);
+
+	static const int kCharWidth = 16;
+
+private:
+	/** 空白正規化:連續空白收斂成單一空格 + 去頭尾。建表與查表兩邊都要套。 */
+	static Common::String normKey(const char *text);
+
+	bool _enabled;
+	bool _logText;
+	const char *_dumpSpr;
+	// 簽章 → 置換點陣（寬,高,像素）
+	Common::HashMap<uint32, Common::Array<byte> > _cels;
+	Common::HashMap<uint32, uint32> _celDims;
+	Graphics::Big5Font *_font;
+	Common::HashMap<Common::String, Common::String> _map;
+};
+
+} // End of namespace Gob
+
+#endif // GOB_CHT_H
