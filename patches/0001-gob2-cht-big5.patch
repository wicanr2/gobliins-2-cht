+	 */
+	virtual Common::String chtCollectTotText(const byte *ptr) const;
+
+	/** 繁中化:在訊息框內自行斷行 + 置中畫出中文。 */
+	void chtPrintTotText(const char *text, int16 left, int16 top,
+	                     int16 right, int16 bottom, byte color);
 };
 
 class Draw_v2 : public Draw_v1 {
 public:
+	/** 繁中化:v2 的文字流控制碼跟 v1 差很多,要自己收。 */
+	Common::String chtCollectTotText(const byte *ptr) const override;
+
 	void initScreen() override;
 	void closeScreen() override;
 	void blitCursor() override;
