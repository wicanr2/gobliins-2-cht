+Common::String Draw_v1::chtCollectTotText(const byte *ptr) const {
+	Common::String out;
+	int16 lastY = -1;
+
+	for (const byte *p = ptr; *p != 1; ) {
+		if (*p == 3) {          // 換字型／顏色
+			p += 2;
+		} else if (*p == 2) {   // 重新定位:Y 變了才算換行
+			int16 y = (int16)READ_LE_UINT16(p + 3);
+			if (lastY >= 0 && y != lastY)
+				out += '\n';
+			lastY = y;
+			p += 5;
+		} else if (*p == 0xBA) { // 變數代入,用佔位符留住位置
+			out += "%s";
+			p++;
+		} else {
+			out += (char)*p;
+			p++;
+		}
+	}
+
+	return out;
+}
+
+void Draw_v1::chtPrintTotText(const char *text, int16 left, int16 top,
+                              int16 right, int16 bottom, byte color) {
+	const int kMargin  = 2;
+	const int chW      = Cht::kCharWidth;
+	const int chH      = _vm->_cht->charHeight();
+	// 行距不另加空隙：倚天 16×15 的字模本身上下已留白，再加只是浪費垂直空間。
+	// 訊息框是遊戲美術的一部分、改不了大小，能調的只有行距與譯文長度。
+	const int lineStep = chH;
+
+	const int boxW  = right - left + 1;
+	const int boxH  = bottom - top + 1;
+	const int availW = MAX(boxW - 2 * kMargin, chW);
+
+	// --- 斷行:以顯示欄寬計算,不是以 byte 數 -------------------------------
+	// 中文一字佔 kCharWidth，ASCII 佔原字型寬。原文的換行(\n)是硬換行，
+	// 其餘照容得下的寬度自己斷。
+	Common::Array<Common::String> lines;
+	Common::String cur;
+	int curW = 0;
+	const int asciiW = _fonts[_fontIndex] ? _fonts[_fontIndex]->getCharWidth() : 6;
+
+	for (const byte *p = (const byte *)text; *p; ) {
+		if (*p == '\n') {
+			lines.push_back(cur);
+			cur.clear();
+			curW = 0;
+			p++;
+			continue;
+		}
+
+		int w;
+		Common::String piece;
+		if (Cht::isBig5Lead(p[0]) && Cht::isBig5Trail(p[1])) {
+			piece = Common::String((const char *)p, 2);
+			w = chW;
+			p += 2;
+		} else {
+			piece = Common::String((const char *)p, 1);
+			w = asciiW;
+			p += 1;
+		}
+
+		if (curW + w > availW && !cur.empty()) {
+			lines.push_back(cur);
+			cur.clear();
+			curW = 0;
+		}
+		cur += piece;
+		curW += w;
+	}
+	if (!cur.empty())
+		lines.push_back(cur);
