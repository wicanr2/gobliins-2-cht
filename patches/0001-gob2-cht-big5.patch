+// --- 繁中化:把一則 TOT 文字收成單一字串 -----------------------------------
+//
+// v2 的文字流跟 v1 差很多,照 v1 的讀法會收到垃圾。控制碼(照本函式下方
+// printTotText 的字元迴圈):
+//   1        結束
+//   2 / 5    重新定位(+4 bytes offX/offY)→ Y 變了才算換行
+//   3        字型+顏色(+1)      4  前景色(+1)
+//   6        可點文字(+1 colCmd;bit7 再吃 2、bit6 再吃 8)
+//   7/8/9    colCmd 歸零 / 遮罩開關
+//   10       索引參照(+1 個數,每個再吃 2)
+//   186      變數代入 → 記成 %s
+//   其餘     字面字元
+//
+// [HARD] 這裡的收字邏輯必須跟 tools/extract_gob2_texts.py 逐條一致,
+//        否則 key 對不起來、實機查表就 MISS —— 靜態檢查全綠、實機卻沒翻。
+Common::String Draw_v2::chtCollectTotText(const byte *ptr) const {
+	Common::String out;
+	int16 lastY = 0;
+	bool  haveY = false;
+	int   guard = 0;
+
+	while (*ptr != 1) {
+		if (++guard > 20000)
+			break;
+
+		const byte cmd = *ptr;
+
+		if ((cmd == 2) || (cmd == 5)) {
+			const int16 y = (int16)READ_LE_UINT16(ptr + 3);
+			if (haveY && (y != lastY))
+				out += '\n';
+			lastY = y;
+			haveY = true;
+			ptr += 5;
+		} else if ((cmd == 3) || (cmd == 4)) {
+			ptr += 2;
+		} else if (cmd == 6) {
+			const byte colCmd = ptr[1];
+			ptr += 2;
+			if (colCmd & 0x80)
+				ptr += 2;
+			if (colCmd & 0x40)
+				ptr += 8;
+		} else if ((cmd == 7) || (cmd == 8) || (cmd == 9)) {
+			ptr += 1;
+		} else if (cmd == 10) {
+			ptr += 2 + ptr[1] * 2;
+		} else if (cmd == 186) {
+			out += "%s";
+			ptr += 1;
+		} else {
+			out += (char)cmd;
+			ptr += 1;
+		}
+	}
+
+	return out;
+}
